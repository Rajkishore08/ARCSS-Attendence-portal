{
  "name": "arcs-attendance-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:api": "npx esbuild server/src/app.ts --bundle --platform=node --target=node18 --format=cjs --outfile=api/index.js --external:googleapis --external:google-auth-library",
    "build": "npm --prefix server install && npm --prefix server run build && npm run build:api && npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server run start",
    "test:sheets": "npm --prefix server run test:sheets"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3"
  }
}
